<script>
window.addEventListener('error',e=>{try{let d=document.getElementById('errbar');if(!d){d=document.createElement('div');d.id='errbar';d.style.cssText='position:fixed;left:8px;right:8px;bottom:8px;z-index:99;background:#7a1f1f;color:#fff;font:12px/1.4 system-ui,sans-serif;padding:8px 10px;border-radius:8px;opacity:.95;word-break:break-word';d.onclick=()=>d.remove();document.body.appendChild(d)}d.textContent='v8 global Error: '+(e.message||e)+' ('+((e.lineno)||'?')+':'+((e.colno)||'?')+') '+((e.error&&e.error.stack)?e.error.stack.split('\n').slice(0,5).join(' < '):'')+' — tocá para cerrar'}catch(x){}});

// ===== Datos =====
const CS=48, LW=5, LH=4;
const C={
  trigo:{n:'Trigo',seed:8,d:6,y:4,p:6,c:'#d9b64a'},
  maiz:{n:'Maíz',seed:14,d:8,y:6,p:6,c:'#e6c83c'},
  alfalfa:{n:'Alfalfa',seed:6,d:5,y:5,p:4,c:'#6dbd4f'},
  remolacha:{n:'Remolacha forrajera',seed:10,d:7,y:5,p:7,c:'#a2386b'}
};
const KEYS=Object.keys(C);
const TOOLS={arar:{n:'Arado',c:'#8d8d8d'},sembrar:{n:'Sembradora',c:'#b5651d'},regar:{n:'Pulverizadora de riego',c:'#4aa3df'},cosechar:{n:'Cosechadora',c:'#e0b030'}};
const S={money:600,fuel:100,day:1,wx:'Soleado',seeds:{trigo:20,maiz:0,alfalfa:0,remolacha:0},store:{trigo:0,maiz:0,alfalfa:0,remolacha:0},tool:'',crop:'trigo',log:[],earned:0,spent:0,sel:0,up:{w:0,e:0},tut:0,ct:null,drought:0,ach:{},stats:{harv:0,sold:0,contracts:0},pm:{trigo:1,maiz:1,alfalfa:1,remolacha:1},pd:{trigo:0,maiz:0,alfalfa:0,remolacha:0}};
const WW=1120, WH=760;
const lots=[[120,110],[440,110],[120,430],[440,430]].map((p,i)=>({id:i+1,x:p[0],y:p[1],own:i<2,cells:Array.from({length:LW*LH},()=>({s:0,crop:null,age:0,water:0}))}));
const T={x:740,y:375,a:Math.PI,v:0};
let dayT=0, keys={}, joy={x:0,y:0}, tAcc=0, saveT=0, noSave=false;
const LOTP=[0,0,900,1800],UPW=[700,1600],UPE=[500,1200,2400],SAVE_KEY='campoVivo.v1';
function saveGame(){if(noSave)return;try{localStorage.setItem(SAVE_KEY,JSON.stringify({S,lots:lots.map(L=>({own:L.own,cells:L.cells})),T:{x:T.x,y:T.y,a:T.a}}))}catch(e){}}
function loadGame(){try{const raw=localStorage.getItem(SAVE_KEY);if(!raw)return false;const d=JSON.parse(raw);if(!d||!d.S||!Array.isArray(d.lots))return false;
  Object.assign(S,d.S);S.up=Object.assign({w:0,e:0},d.S.up);S.tool='';
  d.lots.forEach((l,i)=>{if(lots[i]&&Array.isArray(l.cells)&&l.cells.length===LW*LH){lots[i].own=!!l.own;lots[i].cells=l.cells}});
  if(d.T&&isFinite(d.T.x)&&isFinite(d.T.y)&&isFinite(d.T.a)){T.x=d.T.x;T.y=d.T.y;T.a=d.T.a;T.v=0}return true}catch(e){return false}}
const HAS_SAVE=loadGame();
const TUT=['Elegí «Arar» y recorré un lote','Elegí «Sembrar» y pasá por las celdas aradas','Elegí «Regar» y esperá que el cultivo madure','Cosechá con «Cosechar» cuando esté listo','Vendé tu cosecha en el Mercado (M)'];
function tutCheck(){const el=$('tut');if(S.tut==null)S.tut=0;if(!started){el.style.display='none';return}
  if(S.tut<TUT.length){const cells=[].concat(...lots.filter(L=>L.own).map(L=>L.cells));let ok=false;
    if(S.tut===0)ok=cells.some(c=>c.s>=1);else if(S.tut===1)ok=cells.some(c=>c.s===2);else if(S.tut===2)ok=cells.some(c=>c.s===2&&c.age>=C[c.crop].d);else if(S.tut===3)ok=KEYS.some(k=>S.store[k]>0);else ok=S.earned>0;
    if(ok){S.tut++;sfx('buy');if(S.tut===TUT.length)say('¡Tutorial completo! Seguí ampliando tu campo.')}}
  let h='';if(S.tut<TUT.length)h='<b>Objetivo '+(S.tut+1)+'/'+TUT.length+'</b><br>'+TUT[S.tut]+'<button id="tutX" aria-label="Omitir tutorial">×</button>';
  else if(S.ct){const c=S.ct;h='<b>Contrato</b><br>'+c.q+' u de '+C[c.k].n+' · día '+c.by+'<br><small>'+S.store[c.k]+'/'+c.q+' en el silo</small>'}
  if(!h){el.style.display='none';return}el.style.display='block';if(tutCheck.h!==h){tutCheck.h=h;el.innerHTML=h}}
function toggleFs(){try{const d=document,e=d.documentElement;if(!(d.fullscreenElement||d.webkitFullscreenElement)){const p=(e.requestFullscreen||e.webkitRequestFullscreen).call(e);if(p&&p.catch)p.catch(()=>{})}else{(d.exitFullscreen||d.webkitExitFullscreen).call(d)}}catch(e){}}
function newGame(){if(!confirm('¿Borrar la partida guardada y empezar de cero?'))return;noSave=true;try{localStorage.removeItem(SAVE_KEY)}catch(e){}location.reload()}

// ===== Utilidades =====
const $=id=>document.getElementById(id);
function say(t){const e=$('toast');e.textContent=t;e.style.opacity=1;clearTimeout(say.h);say.h=setTimeout(()=>e.style.opacity=0,1800)}
function note(t){S.log.unshift('Día '+S.day+': '+t);S.log.length=Math.min(S.log.length,8)}
function money(n){return '$'+Math.round(n*10)/10}
function warn(t){const n=performance.now();if(n-warn.t>1500){say(t);warn.t=n}}warn.t=0;

// ===== Trabajo en celdas =====
function cellAt(px,py,any){
  for(const L of lots){
    if(!L.own&&!any)continue;
    const cx=Math.floor((px-L.x)/CS), cy=Math.floor((py-L.y)/CS);
    if(cx>=0&&cx<LW&&cy>=0&&cy<LH) return {L,c:L.cells[cy*LW+cx]};
  }
  return null;
}
function work(){
  if(!S.tool||Math.abs(T.v)<8||S.fuel<=0) return;
  const px=T.x-Math.cos(T.a)*BEH, py=T.y-Math.sin(T.a)*BEH, nx=-Math.sin(T.a), ny=Math.cos(T.a);
  const offs=S.up.w===0?[0]:S.up.w===1?[-.5,.5]:[-1,0,1],seen=new Set();
  for(const o of offs){const x=px+nx*o*CS,y=py+ny*o*CS,h=cellAt(x,y,true);if(!h||seen.has(h.c))continue;seen.add(h.c);
    if(!h.L.own){warn('El lote '+h.L.id+' está en venta. Comprálo en el Mercado.');continue}
    doCell(h.c,x,y)}
}
function doCell(c,px,py){
  const k=S.crop;
  if(S.tool==='arar'){ if(c.s===0){c.s=1;c.crop=null;burst(px,py,'#7a5a3a')} }
  else if(S.tool==='sembrar'){
    if(c.s===1){ if(S.seeds[k]<=0){warn('No tenés semillas de '+C[k].n+'. Comprá en el Mercado.');return}
      S.seeds[k]--;c.s=2;c.crop=k;c.age=0;c.water=.5;burst(px,py,'#efe0a8') } }
  else if(S.tool==='regar'){
    if(c.s===2&&c.water<1){ if(S.money<.5){warn('Sin dinero para riego');return} S.money-=.5;S.spent+=.5;c.water=1;burst(px,py,'#7cc6f0') } }
  else if(S.tool==='cosechar'){
    if(c.s===2&&c.age>=C[c.crop].d){ S.store[c.crop]+=C[c.crop].y;S.stats.harv+=C[c.crop].y;c.s=0;c.age=0;burst(px,py,C[c.crop].c);sfx('pop');
      note('cosecha de '+C[c.crop].n+' (+'+C[c.crop].y+')') } }
}

// ===== Calendario y crecimiento =====
function price(k){return Math.round(C[k].p*S.pm[k]*10)/10}
function newContract(){const k=KEYS[Math.floor(Math.random()*KEYS.length)],q=Math.round(C[k].y*(2+Math.floor(Math.random()*3)));
  S.ct={k,q,by:S.day+7+Math.floor(Math.random()*3),reward:Math.round(q*C[k].p*1.4)};say('Nuevo contrato: '+q+' u de '+C[k].n);note('nuevo contrato de '+q+' '+C[k].n)}
function deliver(){const c=S.ct;if(!c||S.store[c.k]<c.q)return;S.store[c.k]-=c.q;S.money+=c.reward;S.earned+=c.reward;S.stats.contracts++;S.ct=null;note('contrato cumplido (+'+money(c.reward)+')');say('¡Contrato cumplido! +'+money(c.reward));sfx('coin');checkAch();renderMkt();hud()}
const ACH=[['Primera cosecha','Cosechá por primera vez',()=>S.stats.harv>0],['Comerciante','Ganá $1000 en total',()=>S.earned>=1000],['Terrateniente','Comprá los 4 lotes',()=>lots.every(L=>L.own)],['A pleno','Motor y ancho al máximo',()=>S.up.w>=UPW.length&&S.up.e>=UPE.length],['Cumplidor','Entregá 3 contratos',()=>S.stats.contracts>=3],['Gran cosecha','Cosechá 200 unidades',()=>S.stats.harv>=200]];
function checkAch(){ACH.forEach((a,i)=>{if(!S.ach[i]&&a[2]()){S.ach[i]=1;say('🏆 Logro: '+a[0]);sfx('coin');note('logro: '+a[0])}})}
function nextDay(){
  fieldDirty=true;S.day++;
  const r=Math.random();S.wx=r<.2?'Lluvia':r<.3?'Nublado':'Soleado';
  if(S.drought>0){S.drought--;S.wx='Sequía';if(S.drought===0){say('Terminó la sequía');note('terminó la sequía')}}
  else if(Math.random()<.035){S.drought=3;S.wx='Sequía';say('¡Sequía! El agua se evapora más rápido');note('comenzó una sequía')}
  else if(S.wx!=='Lluvia'&&Math.random()<.04){S.wx='Helada';say('¡Helada! Los cultivos jóvenes sufren');note('helada')}
  for(const k of KEYS){const o=S.pm[k];S.pm[k]=Math.max(.65,Math.min(1.5,o+(1-o)*.1+(Math.random()-.5)*.14));S.pd[k]=Math.sign(Math.round((S.pm[k]-o)*100))}
  for(const L of lots)for(const c of L.cells){
    if(c.s!==2)continue;
    if(S.wx==='Lluvia')c.water=1;
    if(S.wx==='Helada'&&c.crop!=='alfalfa'&&c.age<C[c.crop].d)c.age=Math.max(0,c.age-1);
    if(c.age<C[c.crop].d) c.age+=c.water>.2?1:.3;
    c.water=Math.max(0,c.water-(S.drought>0?.6:.3));
  }
  if(S.ct&&S.day>S.ct.by){note('venció el contrato');say('Venció el contrato de '+C[S.ct.k].n);S.ct=null}
  if(!S.ct)newContract();
}

// ===== Mercado =====
function openMkt(){renderMkt();$('mkt').style.display='flex'}
function closeMkt(){$('mkt').style.display='none'}
function buy(k,n){const cost=C[k].seed*n;if(S.money<cost){say('Dinero insuficiente');return}S.money-=cost;S.spent+=cost;S.seeds[k]+=n;note('compra de '+n+' semillas de '+C[k].n);sfx('buy');renderMkt();hud()}
function buyFuel(l){const cost=l*2;if(S.money<cost){say('Dinero insuficiente');return}if(S.fuel>=100){say('Tanque lleno');return}
  const add=Math.min(l,100-S.fuel);S.money-=add*2;S.spent+=add*2;S.fuel+=add;note('carga de '+add+' L de combustible');sfx('buy');renderMkt();hud()}
function sell(k){const q=S.store[k];if(!q){say('No hay '+C[k].n+' almacenado');return}const v=q*price(k);S.money+=v;S.earned+=v;S.stats.sold+=v;S.store[k]=0;note('venta de '+q+' '+C[k].n+' por '+money(v));sfx('coin');renderMkt();hud()}
function buyLot(i){const L=lots[i],p=LOTP[i];if(L.own)return;if(S.money<p){say('Dinero insuficiente');return}S.money-=p;S.spent+=p;L.own=true;note('compra del lote '+L.id);say('¡Lote '+L.id+' es tuyo!');sfx('coin');fieldDirty=true;saveGame();renderMkt();hud()}
function upg(k){const arr=k==='w'?UPW:UPE,lv=S.up[k];if(lv>=arr.length)return;const p=arr[lv];if(S.money<p){say('Dinero insuficiente');return}S.money-=p;S.spent+=p;S.up[k]++;note(k==='w'?'mejora de ancho de trabajo':'mejora de motor');sfx('buy');saveGame();renderMkt();hud()}
function ctHTML(){const c=S.ct;if(!c)return '';const ok=S.store[c.k]>=c.q;
  return `<h3>Contrato</h3><p>Entregar <b>${c.q} u de ${C[c.k].n}</b> antes del día ${c.by} · pago <b>${money(c.reward)}</b><br><small>${S.store[c.k]}/${c.q} en el silo</small><br><button onclick="deliver()" ${ok?'':'disabled'}>Entregar</button></p>`}
function achHTML(){return '<h3>Logros</h3><p>'+ACH.map((a,i)=>`${S.ach[i]?'🏆':'○'} <b>${a[0]}</b> <small>${a[1]}</small>`).join('<br>')+`<br><small>Cosechado: ${S.stats.harv} u · Contratos: ${S.stats.contracts}</small></p>`}
function tallerHTML(){let h='<h3>Terrenos y taller</h3><table>';
  lots.forEach((L,i)=>{if(!L.own)h+=`<tr><td>Lote ${L.id}<br><small>${LW*LH} celdas</small></td><td><button onclick="buyLot(${i})">Comprar · ${money(LOTP[i])}</button></td></tr>`});
  h+=`<tr><td>Ancho de trabajo<br><small>nivel ${S.up.w}/${UPW.length}</small></td><td>${S.up.w<UPW.length?`<button onclick="upg('w')">Mejorar · ${money(UPW[S.up.w])}</button>`:'Máximo'}</td></tr>
  <tr><td>Motor eficiente<br><small>nivel ${S.up.e}/${UPE.length} · −${S.up.e*15}% consumo</small></td><td>${S.up.e<UPE.length?`<button onclick="upg('e')">Mejorar · ${money(UPE[S.up.e])}</button>`:'Máximo'}</td></tr></table>`;return h}
function renderMkt(){
  let h='<h2>Mercado y depósito</h2><table><tr><th>Cultivo</th><th>Semillas</th><th>Comprar</th><th>Silo</th><th>Vender</th></tr>';
  for(const k of KEYS){const c=C[k];
    h+=`<tr><td>${c.n}<br><small>${c.d} días · ${c.y} u/celda · ${money(price(k))}/u ${S.pd[k]>0?'▲':S.pd[k]<0?'▼':'•'}</small></td><td>${S.seeds[k]}</td>
    <td><button onclick="buy('${k}',10)">10 · ${money(c.seed*10)}</button></td>
    <td>${S.store[k]}</td><td><button onclick="sell('${k}')">${money(S.store[k]*price(k))}</button></td></tr>`}
  h+=`</table><p>Combustible: ${S.fuel.toFixed(0)} / 100 L (precio ${money(2)} por L)<br>
  <button onclick="buyFuel(25)">+25 L · ${money(50)}</button> <button onclick="buyFuel(100)">Llenar</button></p>
  ${ctHTML()}${tallerHTML()}${achHTML()}<p>Campaña: ingresos ${money(S.earned)} · gastos ${money(S.spent)} · resultado <b>${money(S.earned-S.spent)}</b></p>
  <div id="log"><b>Registro de actividades</b><br>${S.log.join('<br>')||'Sin actividad todavía.'}</div>
  <p><button class="main" onclick="closeMkt()">Cerrar</button> <button onclick="newGame()">Nueva partida</button></p>`;
  $('mktBox').innerHTML=h;
}

// ===== HUD =====
function hud(){
  $('hMoney').textContent=money(S.money);
  $('hDay').textContent=S.day;$('hWx').textContent=S.wx;{const hh=dayP*24;$('hClock').textContent=String(Math.floor(hh)).padStart(2,'0')+':'+String(Math.floor((hh%1)*60)).padStart(2,'0')}$('hSpd').textContent=Math.round(Math.abs(T.v)*U*3.6);drawMini();
  $('hFuel').style.width=S.fuel+'%';$('hFuel').style.background=S.fuel<20?'#c8452b':'#e0a526';$('hFuelN').textContent=S.fuel.toFixed(0)+' L';
