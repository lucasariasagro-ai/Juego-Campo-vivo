const ray=new THREE.Raycaster(),gplane=new THREE.Plane(new THREE.Vector3(0,1,0),0),hitV=new THREE.Vector3();
cv.addEventListener('pointerdown',e=>{
  const r=cv.getBoundingClientRect();ray.setFromCamera(new THREE.Vector2(((e.clientX-r.left)/r.width)*2-1,-((e.clientY-r.top)/r.height)*2+1),camera);
  if(!ray.ray.intersectPlane(gplane,hitV))return;const wx=hitV.x/U,wy=hitV.z/U;
  lots.forEach((L,i)=>{if(wx>=L.x&&wx<L.x+LW*CS&&wy>=L.y&&wy<L.y+LH*CS){S.sel=i;hud();showInfo()}});
});
// joystick táctil
const jb=$('joy'),kn=$('knob');
function jmove(e){const r=jb.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;
  let dx=(e.clientX-cx)/60,dy=(e.clientY-cy)/60,m=Math.hypot(dx,dy);if(m>1){dx/=m;dy/=m}
  joy.x=Math.abs(dx)<.15&&Math.abs(dy)<.15?0:dx;joy.y=joy.x===0&&Math.abs(dy)<.15?0:dy;
  kn.style.left=(36+dx*36)+'px';kn.style.top=(36+dy*36)+'px'}
jb.addEventListener('pointerdown',e=>{jb.setPointerCapture(e.pointerId);jmove(e)});
jb.addEventListener('pointermove',e=>{if(e.buttons||e.pointerType==='touch')jmove(e)});
function jend(){joy={x:0,y:0};kn.style.left='36px';kn.style.top='36px'}
jb.addEventListener('pointerup',jend);jb.addEventListener('pointercancel',jend);

