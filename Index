  saveT+=dt;if(saveT>8){saveT=0;saveGame()}
  tAcc+=dt;if(tAcc>.15){tAcc=0;hud()}
}
let last=performance.now();
function sanitize(){const out=[];try{scene.traverse(o=>{const g=o.geometry,nm=(o.name||o.type||'obj');
    if(g&&g.attributes){for(const k in g.attributes){if(!g.attributes[k]){delete g.attributes[k];out.push(nm+'.'+k)}}
      if((o.isMesh||o.isLine||o.isPoints)&&!g.attributes.position){o.visible=false;out.push(nm+'.sinposition')}}
    if(o.isInstancedMesh&&!o.instanceMatrix){o.visible=false;out.push(nm+'.instanceMatrix')}
    if(o.isInstancedMesh&&o.instanceMatrix&&!o.instanceColor){o.instanceColor=new THREE.InstancedBufferAttribute(new Float32Array(o.instanceMatrix.count*3).fill(1),3);if(o.material&&!Array.isArray(o.material))o.material.needsUpdate=true}})}catch(x){}return out}
function bisect(){const bad=[],objs=[];scene.traverse(o=>{if(o.isMesh||o.isLine||o.isPoints||o.isSprite)objs.push(o)});
  const vis=objs.map(o=>o.visible);objs.forEach(o=>o.visible=false);
  for(let k=0;k<objs.length;k++){const o=objs[k];if(!vis[k])continue;o.visible=true;
    try{renderer.render(scene,camera)}catch(e){vis[k]=false;const g=o.geometry||{},a=g.attributes?Object.keys(g.attributes).map(q=>q+(g.attributes[q]?'':'=NULL')).join('/'):'-';
      bad.push((o.isInstancedMesh?'Instanced':o.type)+'#'+k+' geo='+(g.type||'?')+' attrs='+a+' idx='+(g.index===null?'null':typeof g.index)+' mat='+(o.material&&o.material.type||'?')+(o.isInstancedMesh?' instMat='+(o.instanceMatrix?'ok':'NULL')+' instCol='+(o.instanceColor?'ok':'null'):''))}
    o.visible=false}
  objs.forEach((o,k)=>o.visible=vis[k]);return bad}
function loop(n){requestAnimationFrame(loop);try{if(!loop.s){loop.s=1;const r0=sanitize();if(r0.length&&window.__bar)window.__bar('Reparado: '+r0.join(', '))}
    const dt=Math.min(.05,(n-last)/1000);last=n;if(started&&$('mkt').style.display!=='flex')step(dt);draw();audioUpd(dt)}catch(e){
    if(PFX.on){PFX.on=false;try{resize()}catch(x){}}
    let extra='';if(!loop.b){loop.b=1;const r=sanitize();let bad=[];try{bad=bisect()}catch(x){}
      if(!bad.length&&!r.length){try{renderer.shadowMap.enabled=false;scene.traverse(o=>{if(o.material&&o.material.needsUpdate!==undefined)o.material.needsUpdate=true})}catch(x){}extra=' | sin culpable en objetos: sombras desactivadas'}
      else extra=' | ocultado: '+r.concat(bad).join(' ; ')}
    if(window.__bar)window.__bar('v8 loop Error: '+(e&&e.message||e)+' '+((e&&e.stack)?e.stack.split('\n').slice(0,5).join(' < '):'')+extra);console.error(e)}}

