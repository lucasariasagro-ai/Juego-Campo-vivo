@media(pointer:coarse),(hover:none),(max-width:700px){#joy{display:block}}
@media(max-width:640px){#hud{gap:2px 12px;padding:7px 12px;font-size:11.5px;border-radius:14px}#hud::before{font-size:14px}#hud b{font-size:15px}#fuelbar{width:44px}#bar{gap:2px;padding:4px}button,select{min-height:42px;padding:0 10px;font-size:13px}button[data-t]::before{margin-right:5px}#info{font-size:11.5px;padding:8px 10px;min-width:0}}
