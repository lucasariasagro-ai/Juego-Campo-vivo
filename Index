#mkt button{min-height:36px;padding:0 12px;font-size:13px;background:var(--line)}
#mkt button:hover{background:var(--brand);color:#fff}
#log{font-size:12px;color:var(--soft);line-height:1.6;margin:10px 0}

#hTool{display:none}
#hud .main{min-height:38px;padding:0 16px}
#info{display:none}#info.show{display:block}
#cropbox{position:absolute;z-index:3;left:50%;transform:translateX(-50%);bottom:calc(var(--barH,56px) + 22px + env(safe-area-inset-bottom,0px));display:none;background:var(--card);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:14px;padding:4px;box-shadow:0 8px 28px rgba(0,0,0,.25)}
#cropbox.show{display:block}
