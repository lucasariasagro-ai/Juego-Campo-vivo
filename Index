button[data-t]::before{display:none}
button[data-t] svg{margin-right:7px;vertical-align:-4px}
button[data-t="arar"] svg{color:#8d949b}button[data-t="sembrar"] svg{color:#d0602a}button[data-t="regar"] svg{color:#3d8fc4}button[data-t="cosechar"] svg{color:#d9a61f}
button.on svg{color:inherit!important}
.ic{display:inline-flex;align-items:center;gap:7px}.ic>svg{color:var(--brand);flex:none}
#intro{position:absolute;z-index:8;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;color:#f6f2e2;background:linear-gradient(180deg,rgba(10,22,12,.5),rgba(10,22,12,.82));backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);transition:opacity .6s}
