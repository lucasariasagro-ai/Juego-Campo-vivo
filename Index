button,select{font:inherit;font-size:14px;font-weight:700;min-height:44px;padding:0 14px;border-radius:12px;border:0;background:transparent;color:var(--ink);cursor:pointer;transition:background .15s,transform .1s}
select{background:var(--line);padding:0 10px}
button:hover{background:var(--line)}
button:active{transform:scale(.96)}
button:focus-visible,select:focus-visible{outline:3px solid var(--amber);outline-offset:1px}
button[data-t]::before{content:"";display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:8px;border:2px solid var(--soft)}
button[data-t="arar"]::before{background:#9aa0a6;border-color:#9aa0a6}
button[data-t="sembrar"]::before{background:#d0602a;border-color:#d0602a}
button[data-t="regar"]::before{background:#3d8fc4;border-color:#3d8fc4}
