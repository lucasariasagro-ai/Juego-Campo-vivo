addEventListener('keydown',e=>{if(!started)return;
  const k=e.key.length===1?e.key.toLowerCase():e.key;keys[k]=true;
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();
  if(k==='1')setTool('arar');if(k==='2')setTool('sembrar');if(k==='3')setTool('regar');if(k==='4')setTool('cosechar');if(k==='0')setTool('');
  if(k==='c')toggleCam();if(k==='f')toggleFs();if(k==='m'||k==='M'){$('mkt').style.display==='flex'?closeMkt():openMkt()}
